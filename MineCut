<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MineCut — Editor de Vídeo</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@400;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg: #0a0a0c;
  --bg-raised: #141317;
  --bg-panel: #17161a;
  --line: #2a282e;
  --line-soft: #201f24;
  --red: #e0212b;
  --red-bright: #ff3b44;
  --red-dim: #5c1015;
  --text: #f2f0ee;
  --text-dim: #9a979e;
  --text-faint: #605d64;
  --radius: 3px;
  --font-display: 'Anton', 'Arial Narrow', sans-serif;
  --font-body: 'Inter', system-ui, sans-serif;
  --font-mono: 'Space Mono', 'Courier New', monospace;
}

*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-body);
  -webkit-font-smoothing:antialiased;
}
button, input, select{font-family:inherit; color:inherit;}
::selection{background:var(--red-dim); color:var(--text);}

.app{
  display:flex;
  flex-direction:column;
  height:100vh;
  min-height:560px;
}

/* ===== TOPBAR ===== */
.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 20px;
  height:56px;
  flex:none;
  background:var(--bg-raised);
  border-bottom:1px solid var(--line);
}
.brand{display:flex; align-items:center; gap:10px;}
.brand__mark{height:34px; width:auto; display:block;}
.brand__word{height:22px; width:auto; display:block;}
.topbar__actions{display:flex; gap:10px;}

.btn{
  border:1px solid var(--line);
  background:transparent;
  color:var(--text);
  padding:9px 16px;
  border-radius:var(--radius);
  font-size:13px;
  font-weight:600;
  cursor:pointer;
  transition:background .15s, border-color .15s, transform .1s;
  white-space:nowrap;
}
.btn:hover{border-color:var(--text-dim);}
.btn:active{transform:scale(.97);}
.btn--ghost{border-color:transparent; color:var(--text-dim);}
.btn--ghost:hover{color:var(--text); background:var(--bg-panel);}
.btn--primary{background:var(--red); border-color:var(--red); color:#fff;}
.btn--primary:hover{background:var(--red-bright); border-color:var(--red-bright);}
.btn--secondary{background:var(--bg-panel); border-color:var(--line);}
.btn--block{width:100%; padding:12px; margin-top:14px;}

/* ===== WORKSPACE ===== */
.workspace{
  display:flex;
  flex:1;
  min-height:0;
}

/* ===== SIDEBAR ===== */
.sidebar{
  width:84px;
  flex:none;
  background:var(--bg-raised);
  border-right:1px solid var(--line);
  display:flex;
  flex-direction:column;
  padding:12px 0;
  overflow-y:auto;
}
.tool{
  background:none;
  border:none;
  color:var(--text-dim);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:6px;
  padding:12px 4px;
  cursor:pointer;
  position:relative;
  font-size:11px;
  font-weight:500;
}
.tool svg{width:22px; height:22px;}
.tool:hover{color:var(--text);}
.tool.active{color:var(--red-bright);}
.tool.active::before{
  content:"";
  position:absolute;
  left:0; top:8px; bottom:8px;
  width:3px;
  background:var(--red);
  border-radius:0 2px 2px 0;
}

/* ===== PAINEL CONTEXTUAL ===== */
.panel{
  width:300px;
  flex:none;
  background:var(--bg-panel);
  border-right:1px solid var(--line);
  padding:22px 20px;
  overflow-y:auto;
}
.panel__title{
  font-family:var(--font-display);
  font-size:22px;
  letter-spacing:0.5px;
  margin:0 0 6px;
  color:var(--text);
}
.panel__title::after{
  content:"";
  display:block;
  width:28px; height:3px;
  background:var(--red);
  margin-top:8px;
}
.panel__hint{color:var(--text-dim); font-size:13px; line-height:1.5; margin:14px 0 18px;}
.panel__note{color:var(--text-faint); font-size:12px; line-height:1.5; margin-top:12px;}

.dropzone{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8px;
  text-align:center;
  border:1.5px dashed var(--line);
  border-radius:var(--radius);
  padding:26px 14px;
  cursor:pointer;
  color:var(--text-dim);
  transition:border-color .15s, color .15s;
}
.dropzone:hover{border-color:var(--red); color:var(--text);}
.dropzone svg{width:26px; height:26px; color:var(--red);}
.dropzone strong{font-size:13px; color:var(--text);}
.dropzone span{font-size:12px;}

.gallery{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:16px;
}
.gallery__item{
  position:relative;
  aspect-ratio:1/1;
  border-radius:var(--radius);
  overflow:hidden;
  border:1px solid var(--line);
  cursor:grab;
  background:#000;
}
.gallery__item img, .gallery__item video{width:100%; height:100%; object-fit:cover;}
.gallery__item .badge{
  position:absolute; bottom:4px; right:4px;
  background:rgba(0,0,0,.7);
  color:#fff; font-family:var(--font-mono);
  font-size:10px; padding:1px 5px; border-radius:2px;
}
.gallery__item:hover{border-color:var(--red);}

.field{margin-bottom:16px;}
.field label{display:block; font-size:12px; color:var(--text-dim); margin-bottom:6px; font-weight:600;}
.field input[type="range"]{width:100%; accent-color:var(--red);}
.field__value{display:block; font-family:var(--font-mono); font-size:11px; color:var(--text-faint); margin-top:2px;}
.field--inline{display:flex; gap:8px;}
.field--inline input{flex:1;}
.field--row{display:flex; gap:12px;}
.field--row > div{flex:1;}
input[type="text"], input[type="url"], input[type="number"], select{
  width:100%;
  background:var(--bg-raised);
  border:1px solid var(--line);
  color:var(--text);
  padding:9px 10px;
  border-radius:var(--radius);
  font-size:13px;
}
input[type="color"]{width:100%; height:36px; background:var(--bg-raised); border:1px solid var(--line); border-radius:var(--radius); padding:2px;}
.check{display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-dim); margin-bottom:14px; cursor:pointer;}
.check input{accent-color:var(--red);}

.sfx-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:16px;}
.sfx-chip{
  background:var(--bg-raised);
  border:1px solid var(--line);
  color:var(--text);
  padding:10px 6px;
  border-radius:var(--radius);
  font-size:12px;
  cursor:pointer;
}
.sfx-chip:hover{border-color:var(--red); color:var(--red-bright);}

.chip-list{list-style:none; margin:14px 0 0; padding:0; display:flex; flex-direction:column; gap:8px;}
.chip-list li{
  display:flex; align-items:center; justify-content:space-between;
  background:var(--bg-raised);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:8px 10px;
  font-size:12.5px;
  cursor:grab;
}
.chip-list li .remove{background:none; border:none; color:var(--text-faint); cursor:pointer; font-size:14px;}
.chip-list li .remove:hover{color:var(--red-bright);}

.record-status{display:flex; align-items:center; gap:8px; margin-top:14px; font-size:13px; color:var(--red-bright); font-family:var(--font-mono);}
.record-status .dot{width:9px; height:9px; border-radius:50%; background:var(--red); animation:pulse 1s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.25;}}

/* ===== STAGE (preview + timeline) ===== */
.stage{
  flex:1;
  display:flex;
  flex-direction:column;
  min-width:0;
  background:
    radial-gradient(ellipse at top, rgba(224,33,43,0.06), transparent 60%),
    var(--bg);
}
.preview{flex:1; display:flex; flex-direction:column; min-height:0; padding:24px 24px 0;}
.preview__frame{
  flex:1;
  position:relative;
  background:#000;
  border:1px solid var(--line);
  border-radius:6px;
  overflow:hidden;
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:0;
}
.preview__frame video, .preview__frame img{max-width:100%; max-height:100%; width:100%; height:100%; object-fit:contain;}
.preview__empty{
  position:absolute; inset:0;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
  color:var(--text-faint); font-size:13px; text-align:center; line-height:1.6;
}
.preview__empty-logo{width:64px; height:auto; opacity:0.55; margin-bottom:4px;}
.overlay-text{
  position:absolute; left:0; right:0; text-align:center;
  font-family:var(--font-display);
  font-size:clamp(18px,4vw,42px);
  text-shadow:0 2px 10px rgba(0,0,0,.8);
  padding:0 20px;
  pointer-events:none;
}
.overlay-text.pos-top{top:6%;}
.overlay-text.pos-center{top:50%; transform:translateY(-50%);}
.overlay-text.pos-bottom{bottom:6%;}

.preview__controls{
  display:flex; align-items:center; gap:12px;
  padding:14px 2px;
}
.btn-icon{
  background:var(--red);
  border:none;
  color:#fff;
  width:36px; height:36px;
  border-radius:50%;
  cursor:pointer;
  font-size:13px;
  flex:none;
}
.btn-icon:hover{background:var(--red-bright);}
.timecode{font-family:var(--font-mono); font-size:12px; color:var(--text-dim); flex:none;}
.scrubber{flex:1; accent-color:var(--red);}

.timeline{
  flex:none;
  height:150px;
  border-top:1px solid var(--line);
  background:var(--bg-raised);
  padding:12px 24px;
  display:flex;
  flex-direction:column;
  gap:10px;
  overflow-x:auto;
}
.timeline__row{display:flex; align-items:stretch; gap:10px; height:56px;}
.timeline__label{
  flex:none; width:52px;
  font-family:var(--font-mono);
  font-size:10px;
  color:var(--text-faint);
  display:flex; align-items:center;
  letter-spacing:1px;
}
.timeline__track{
  flex:1;
  display:flex;
  gap:4px;
  background:
    repeating-linear-gradient(90deg, transparent, transparent 23px, var(--line-soft) 23px, var(--line-soft) 24px),
    var(--bg-panel);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:6px;
  min-width:100%;
}
.timeline__track--audio{
  background:
    repeating-linear-gradient(90deg, transparent, transparent 23px, var(--line-soft) 23px, var(--line-soft) 24px),
    var(--bg-panel);
}
.clip{
  flex:none;
  min-width:60px;
  background:linear-gradient(180deg, #3a1418, #26090c);
  border:1px solid var(--red-dim);
  border-radius:2px;
  color:var(--text);
  font-size:10.5px;
  font-family:var(--font-mono);
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:4px 8px;
  cursor:grab;
  position:relative;
  user-select:none;
}
.clip.selected{border-color:var(--red-bright); box-shadow:0 0 0 1px var(--red-bright);}
.clip .clip__name{color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.clip .clip__dur{color:var(--text-faint);}
.clip--audio{background:linear-gradient(180deg,#1d1d22,#141317); border-color:var(--line);}
.clip--sfx{background:linear-gradient(180deg,#3a1418,#26090c); border-style:dashed;}

/* ===== TOAST ===== */
.toast{
  position:fixed;
  bottom:22px; left:50%;
  transform:translate(-50%, 20px);
  background:var(--bg-raised);
  border:1px solid var(--red);
  color:var(--text);
  padding:10px 18px;
  border-radius:var(--radius);
  font-size:13px;
  opacity:0;
  pointer-events:none;
  transition:opacity .2s, transform .2s;
  z-index:50;
}
.toast.show{opacity:1; transform:translate(-50%, 0);}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px){
  .panel{width:240px;}
  .sidebar{width:68px;}
  .tool span{display:none;}
}
@media (max-width: 700px){
  .workspace{flex-direction:column; overflow-y:auto;}
  .sidebar{width:100%; flex-direction:row; justify-content:space-around; padding:6px 0;}
  .tool.active::before{left:8px; right:8px; top:auto; bottom:0; width:auto; height:3px; border-radius:2px 2px 0 0;}
  .panel{width:100%; border-right:none; border-bottom:1px solid var(--line);}
}

:focus-visible{outline:2px solid var(--red-bright); outline-offset:2px;}
@media (prefers-reduced-motion: reduce){
  * {animation-duration:.001s !important; transition-duration:.001s !important;}
}

</style>
</head>
<body>

<div class="app">

  <!-- ===== TOPBAR ===== -->
  <header class="topbar">
    <div class="brand">
      <img class="brand__mark" src="data:image/png;base64," alt="">
      <img class="brand__word" src="data:image/png;base64," alt="MineCut">
    </div>

    <nav class="topbar__actions">
      <button class="btn btn--ghost" id="btnUndo" title="Desfazer o último corte">↺ Desfazer</button>
      <button class="btn btn--ghost" id="btnNew" title="Começar um projeto novo">+ Novo projeto</button>
      <button class="btn btn--primary" id="btnExport" title="Baixar a edição selecionada">Exportar ▸</button>
    </nav>
  </header>

  <div class="workspace">

    <!-- ===== SIDEBAR: FERRAMENTAS ===== -->
    <aside class="sidebar" aria-label="Ferramentas de edição">
      <button class="tool active" data-panel="import">
        <svg viewBox="0 0 24 24"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 19h16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Importar</span>
      </button>
      <button class="tool" data-panel="cut">
        <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18M9 9a3 3 0 100-6 3 3 0 000 6zm0 12a3 3 0 100-6 3 3 0 000 6z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Cortar</span>
      </button>
      <button class="tool" data-panel="record">
        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="2" fill="none"/><circle cx="10" cy="10.5" r="2.6" fill="currentColor"/><path d="M17 9l4-2.5v8L17 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linejoin="round"/></svg>
        <span>Gravar tela</span>
      </button>
      <button class="tool" data-panel="sfx">
        <svg viewBox="0 0 24 24"><path d="M4 10v4h4l5 4V6l-5 4H4z" stroke="currentColor" stroke-width="2" fill="none" stroke-linejoin="round"/><path d="M16 9a4 4 0 010 6M19 6a8 8 0 010 12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        <span>Sons</span>
      </button>
      <button class="tool" data-panel="text">
        <svg viewBox="0 0 24 24"><path d="M5 6h14M12 6v13M9 19h6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
        <span>Texto</span>
      </button>
      <button class="tool" data-panel="join">
        <svg viewBox="0 0 24 24"><rect x="2" y="9" width="7" height="6" rx="1" stroke="currentColor" stroke-width="2" fill="none"/><rect x="15" y="9" width="7" height="6" rx="1" stroke="currentColor" stroke-width="2" fill="none"/><path d="M9 12h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Juntar</span>
      </button>
      <button class="tool" data-panel="audio">
        <svg viewBox="0 0 24 24"><path d="M3 12h2l3-7 4 14 3-10 2 3h4" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Áudio</span>
      </button>
    </aside>

    <!-- ===== PAINEL CONTEXTUAL (muda conforme a ferramenta) ===== -->
    <section class="panel" id="panel">

      <div class="panel__section" data-panel-content="import">
        <h2 class="panel__title">01 · Importar</h2>
        <p class="panel__hint">Traga fotos e vídeos da galeria do seu celular ou computador.</p>
        <label class="dropzone" id="dropzone">
          <input type="file" id="fileInput" accept="video/*,image/*" multiple hidden>
          <svg viewBox="0 0 24 24"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <strong>Toque para escolher da galeria</strong>
          <span>ou arraste os arquivos aqui</span>
        </label>
        <div class="gallery" id="gallery"></div>
      </div>

      <div class="panel__section" data-panel-content="cut" hidden>
        <h2 class="panel__title">02 · Cortar</h2>
        <p class="panel__hint">Selecione um clipe na linha do tempo, marque o trecho e corte. Cada corte vira um novo pedaço — os anteriores continuam intactos.</p>
        <div class="field">
          <label for="trimStart">Início do trecho</label>
          <input type="range" id="trimStart" min="0" max="100" value="0" step="0.1">
          <span class="field__value" id="trimStartVal">0:00</span>
        </div>
        <div class="field">
          <label for="trimEnd">Fim do trecho</label>
          <input type="range" id="trimEnd" min="0" max="100" value="100" step="0.1">
          <span class="field__value" id="trimEndVal">0:00</span>
        </div>
        <button class="btn btn--primary btn--block" id="btnCut">✂ Cortar trecho selecionado</button>
        <p class="panel__note">O trecho marcado vira um clipe novo na linha do tempo. O clipe original some da lista de clipes ativos, mas nada de antes é apagado.</p>
      </div>

      <div class="panel__section" data-panel-content="record" hidden>
        <h2 class="panel__title">03 · Gravar tela</h2>
        <p class="panel__hint">Grave a tela enquanto assiste algo ou joga. Funciona direto no navegador.</p>
        <label class="check"><input type="checkbox" id="recordMic" checked> Gravar áudio junto</label>
        <button class="btn btn--primary btn--block" id="btnRecord">● Iniciar gravação</button>
        <div class="record-status" id="recordStatus" hidden>
          <span class="dot"></span> Gravando… <span id="recordTimer">0:00</span>
        </div>
      </div>

      <div class="panel__section" data-panel-content="sfx" hidden>
        <h2 class="panel__title">04 · Efeitos sonoros</h2>
        <p class="panel__hint">Adicione um efeito pronto ou cole o link de um som da internet.</p>
        <div class="sfx-grid">
          <button class="sfx-chip" data-sfx="pop">Pop</button>
          <button class="sfx-chip" data-sfx="whoosh">Whoosh</button>
          <button class="sfx-chip" data-sfx="click">Clique</button>
          <button class="sfx-chip" data-sfx="alert">Alerta</button>
          <button class="sfx-chip" data-sfx="boom">Boom</button>
          <button class="sfx-chip" data-sfx="ding">Ding</button>
        </div>
        <div class="field field--inline">
          <input type="url" id="sfxUrl" placeholder="Colar link de um som (URL de áudio)">
          <button class="btn btn--secondary" id="btnAddSfxUrl">Adicionar</button>
        </div>
      </div>

      <div class="panel__section" data-panel-content="text" hidden>
        <h2 class="panel__title">05 · Texto</h2>
        <p class="panel__hint">Escreva algo para aparecer em cima do vídeo, num momento específico.</p>
        <div class="field">
          <label for="textContent">Texto</label>
          <input type="text" id="textContent" placeholder="Ex: LEGENDÁRIO">
        </div>
        <div class="field field--row">
          <div>
            <label for="textStart">Aparece em</label>
            <input type="number" id="textStart" min="0" step="0.5" value="0"> s
          </div>
          <div>
            <label for="textDuration">Duração</label>
            <input type="number" id="textDuration" min="0.5" step="0.5" value="2"> s
          </div>
        </div>
        <div class="field field--row">
          <div>
            <label for="textColor">Cor</label>
            <input type="color" id="textColor" value="#ffffff">
          </div>
          <div>
            <label for="textPos">Posição</label>
            <select id="textPos">
              <option value="top">Topo</option>
              <option value="center" selected>Centro</option>
              <option value="bottom">Base</option>
            </select>
          </div>
        </div>
        <button class="btn btn--primary btn--block" id="btnAddText">+ Adicionar texto</button>
        <ul class="chip-list" id="textList"></ul>
      </div>

      <div class="panel__section" data-panel-content="join" hidden>
        <h2 class="panel__title">06 · Juntar vídeos</h2>
        <p class="panel__hint">Arraste os clipes na linha do tempo abaixo para reordenar. A pré-visualização toca tudo em sequência, como se fosse um vídeo só.</p>
        <ul class="chip-list" id="joinList"></ul>
      </div>

      <div class="panel__section" data-panel-content="audio" hidden>
        <h2 class="panel__title">07 · Áudio</h2>
        <p class="panel__hint">Corte ou silencie o áudio original do clipe selecionado, separado da imagem.</p>
        <label class="check"><input type="checkbox" id="muteOriginal"> Silenciar áudio original do clipe</label>
        <div class="field">
          <label for="audioStart">Início do trecho de áudio</label>
          <input type="range" id="audioStart" min="0" max="100" value="0" step="0.1">
          <span class="field__value" id="audioStartVal">0:00</span>
        </div>
        <div class="field">
          <label for="audioEnd">Fim do trecho de áudio</label>
          <input type="range" id="audioEnd" min="0" max="100" value="100" step="0.1">
          <span class="field__value" id="audioEndVal">0:00</span>
        </div>
        <button class="btn btn--primary btn--block" id="btnCutAudio">🎧 Cortar só o áudio</button>
      </div>

    </section>

    <!-- ===== PREVIEW + TIMELINE ===== -->
    <main class="stage">
      <div class="preview">
        <div class="preview__frame" id="previewFrame">
          <video id="previewVideo" playsinline></video>
          <img id="previewImage" hidden alt="">
          <div class="preview__empty" id="previewEmpty">
            <img class="preview__empty-logo" src="data:image/png;base64," alt="">
            Nada selecionado ainda.<br>Importe um arquivo para começar.
          </div>
          <div class="overlay-text" id="overlayText" hidden></div>
        </div>
        <div class="preview__controls">
          <button class="btn-icon" id="btnPlay" title="Reproduzir/Pausar">▶</button>
          <span class="timecode" id="timeNow">0:00</span>
          <input type="range" id="scrubber" min="0" max="100" value="0" step="0.01" class="scrubber">
          <span class="timecode" id="timeTotal">0:00</span>
        </div>
      </div>

      <div class="timeline" aria-label="Linha do tempo">
        <div class="timeline__row">
          <span class="timeline__label">VÍDEO</span>
          <div class="timeline__track" id="trackVideo"></div>
        </div>
        <div class="timeline__row">
          <span class="timeline__label">ÁUDIO</span>
          <div class="timeline__track timeline__track--audio" id="trackAudio"></div>
        </div>
      </div>
    </main>

  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* =========================================================
   MINECUT — base do editor de vídeo (protótipo em navegador)
   Tudo roda no lado do cliente, sem servidor.
   ========================================================= */

const state = {
  clips: [],         // {id, type:'video'|'image', name, url, duration, hasAudio}
  audioClips: [],     // {id, name, url, duration, sourceClipId}
  timeline: [],       // ordered array of clip ids (video track = a sequência final)
  textOverlays: [],   // {id, text, start, duration, color, pos}
  selectedClipId: null,
  isPlaying: false,
  mediaRecorder: null,
  recordedChunks: [],
  recordTimerId: null,
  recordSeconds: 0,
};

let idCounter = 1;
const newId = () => 'c' + (idCounter++);

/* ---------- helpers ---------- */
const $ = (sel) => document.querySelector(sel);
const fmtTime = (s) => {
  if (!isFinite(s) || s < 0) s = 0;
  const m = Math.floor(s / 60);
  const sec = Math.floor(s % 60).toString().padStart(2, '0');
  return `${m}:${sec}`;
};
function toast(msg) {
  const t = $('#toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toast._tm);
  toast._tm = setTimeout(() => t.classList.remove('show'), 2400);
}
function getClip(id) { return state.clips.find(c => c.id === id); }

/* =========================================================
   NAVEGAÇÃO ENTRE PAINÉIS
   ========================================================= */
document.querySelectorAll('.tool').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tool').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const target = btn.dataset.panel;
    document.querySelectorAll('[data-panel-content]').forEach(sec => {
      sec.hidden = sec.dataset.panelContent !== target;
    });
  });
});

/* =========================================================
   01 — IMPORTAR
   ========================================================= */
const fileInput = $('#fileInput');
const dropzone = $('#dropzone');
const gallery = $('#gallery');

dropzone.addEventListener('click', (e) => { /* label already triggers input */ });
fileInput.addEventListener('change', (e) => handleFiles(e.target.files));

['dragover', 'dragleave', 'drop'].forEach(evt => {
  dropzone.addEventListener(evt, (e) => e.preventDefault());
});
dropzone.addEventListener('drop', (e) => handleFiles(e.dataTransfer.files));

function handleFiles(fileList) {
  [...fileList].forEach(file => {
    const url = URL.createObjectURL(file);
    const isVideo = file.type.startsWith('video');
    const clip = {
      id: newId(),
      type: isVideo ? 'video' : 'image',
      name: file.name,
      url,
      duration: 4, // default for images; updated below for video
      hasAudio: isVideo,
    };
    state.clips.push(clip);

    if (isVideo) {
      const probe = document.createElement('video');
      probe.preload = 'metadata';
      probe.src = url;
      probe.onloadedmetadata = () => {
        clip.duration = probe.duration || 4;
        renderGallery();
      };
    }
    addToTimeline(clip.id);
  });
  renderGallery();
  toast(`${fileList.length} arquivo(s) importado(s)`);
}

function renderGallery() {
  gallery.innerHTML = '';
  state.clips.forEach(clip => {
    const div = document.createElement('div');
    div.className = 'gallery__item';
    div.draggable = true;
    div.dataset.id = clip.id;
    if (clip.type === 'video') {
      div.innerHTML = `<video src="${clip.url}" muted></video><span class="badge">${fmtTime(clip.duration)}</span>`;
    } else {
      div.innerHTML = `<img src="${clip.url}" alt="${clip.name}"><span class="badge">img</span>`;
    }
    div.addEventListener('click', () => selectClip(clip.id));
    div.addEventListener('dragstart', (e) => e.dataTransfer.setData('text/clip-id', clip.id));
    gallery.appendChild(div);
  });
}

/* =========================================================
   LINHA DO TEMPO (junção de vídeos = ordem da timeline)
   ========================================================= */
const trackVideo = $('#trackVideo');
const trackAudio = $('#trackAudio');

function addToTimeline(clipId) {
  state.timeline.push(clipId);
  renderTimeline();
  selectClip(clipId);
}

function renderTimeline() {
  trackVideo.innerHTML = '';
  state.timeline.forEach(id => {
    const clip = getClip(id);
    if (!clip) return;
    const el = document.createElement('div');
    el.className = 'clip' + (clip.id === state.selectedClipId ? ' selected' : '');
    el.draggable = true;
    el.dataset.id = clip.id;
    el.style.width = Math.max(60, clip.duration * 14) + 'px';
    el.innerHTML = `<span class="clip__name">${clip.name}</span><span class="clip__dur">${fmtTime(clip.duration)}</span>`;
    el.addEventListener('click', () => selectClip(clip.id));
    el.addEventListener('dragstart', (e) => { e.dataTransfer.setData('text/timeline-id', clip.id); });
    trackVideo.appendChild(el);
  });

  trackAudio.innerHTML = '';
  state.audioClips.forEach(a => {
    const el = document.createElement('div');
    el.className = 'clip clip--audio';
    el.style.width = Math.max(60, a.duration * 14) + 'px';
    el.innerHTML = `<span class="clip__name">${a.name}</span><span class="clip__dur">${fmtTime(a.duration)}</span>`;
    trackAudio.appendChild(el);
  });

  renderJoinList();
}
[trackVideo].forEach(track => {
  track.addEventListener('dragover', (e) => e.preventDefault());
  track.addEventListener('drop', (e) => {
    e.preventDefault();
    const galleryId = e.dataTransfer.getData('text/clip-id');
    if (galleryId) { addToTimeline(galleryId); return; }
    const draggedId = e.dataTransfer.getData('text/timeline-id');
    if (!draggedId) return;
    const target = e.target.closest('.clip');
    const from = state.timeline.indexOf(draggedId);
    if (from === -1) return;
    state.timeline.splice(from, 1);
    const to = target ? state.timeline.indexOf(target.dataset.id) : state.timeline.length;
    state.timeline.splice(to, 0, draggedId);
    renderTimeline();
  });
});

function selectClip(id) {
  state.selectedClipId = id;
  renderTimeline();
  loadIntoPreview(id);
}

/* =========================================================
   PREVIEW
   ========================================================= */
const previewVideo = $('#previewVideo');
const previewImage = $('#previewImage');
const previewEmpty = $('#previewEmpty');
const scrubber = $('#scrubber');
const timeNow = $('#timeNow');
const timeTotal = $('#timeTotal');
const btnPlay = $('#btnPlay');

function loadIntoPreview(id) {
  const clip = getClip(id);
  if (!clip) return;
  previewEmpty.hidden = true;
  if (clip.type === 'video') {
    previewImage.hidden = true;
    previewVideo.hidden = false;
    previewVideo.src = clip.url;
    previewVideo.load();
  } else {
    previewVideo.hidden = true;
    previewImage.hidden = false;
    previewImage.src = clip.url;
    timeTotal.textContent = fmtTime(clip.duration);
  }
  // sync trim + audio sliders' max to this clip duration
  [$('#trimStart'), $('#trimEnd'), $('#audioStart'), $('#audioEnd')].forEach(r => r.max = clip.duration || 4);
  $('#trimEnd').value = clip.duration || 4;
  $('#audioEnd').value = clip.duration || 4;
  updateTrimLabels();
}

previewVideo.addEventListener('loadedmetadata', () => {
  scrubber.max = previewVideo.duration;
  timeTotal.textContent = fmtTime(previewVideo.duration);
});
previewVideo.addEventListener('timeupdate', () => {
  scrubber.value = previewVideo.currentTime;
  timeNow.textContent = fmtTime(previewVideo.currentTime);
  updateTextOverlay(previewVideo.currentTime);
});
scrubber.addEventListener('input', () => { previewVideo.currentTime = scrubber.value; });
btnPlay.addEventListener('click', () => {
  if (previewVideo.hidden) return;
  if (previewVideo.paused) { previewVideo.play(); btnPlay.textContent = '❚❚'; }
  else { previewVideo.pause(); btnPlay.textContent = '▶'; }
});

/* =========================================================
   02 — CORTAR (não destrutivo)
   ========================================================= */
const trimStart = $('#trimStart'), trimEnd = $('#trimEnd');
function updateTrimLabels() {
  $('#trimStartVal').textContent = fmtTime(+trimStart.value);
  $('#trimEndVal').textContent = fmtTime(+trimEnd.value);
}
trimStart.addEventListener('input', updateTrimLabels);
trimEnd.addEventListener('input', updateTrimLabels);

$('#btnCut').addEventListener('click', () => {
  const clip = getClip(state.selectedClipId);
  if (!clip) { toast('Selecione um clipe na linha do tempo primeiro'); return; }
  const start = +trimStart.value, end = +trimEnd.value;
  if (end <= start) { toast('O fim precisa ser depois do início'); return; }

  // Cria um NOVO clipe representando só o trecho marcado.
  // O original permanece no state.clips (histórico) — nada é apagado.
  const newClip = {
    id: newId(),
    type: clip.type,
    name: `${clip.name} (corte ${fmtTime(start)}–${fmtTime(end)})`,
    url: clip.url,
    duration: end - start,
    hasAudio: clip.hasAudio,
    trimIn: start,
    trimOut: end,
  };
  state.clips.push(newClip);

  // troca o clipe original pela versão cortada na timeline, mas mantém o restante do histórico
  const idx = state.timeline.indexOf(clip.id);
  if (idx !== -1) state.timeline[idx] = newClip.id;
  else state.timeline.push(newClip.id);

  renderGallery();
  renderTimeline();
  selectClip(newClip.id);
  toast('Trecho cortado e adicionado à linha do tempo');
});

/* =========================================================
   03 — GRAVAR TELA
   ========================================================= */
const btnRecord = $('#btnRecord');
const recordStatus = $('#recordStatus');
const recordTimer = $('#recordTimer');

btnRecord.addEventListener('click', async () => {
  if (state.mediaRecorder && state.mediaRecorder.state === 'recording') {
    stopRecording();
    return;
  }
  try {
    const withAudio = $('#recordMic').checked;
    const stream = await navigator.mediaDevices.getDisplayMedia({
      video: { cursor: 'always' },
      audio: withAudio,
    });
    state.recordedChunks = [];
    state.mediaRecorder = new MediaRecorder(stream);
    state.mediaRecorder.ondataavailable = (e) => { if (e.data.size) state.recordedChunks.push(e.data); };
    state.mediaRecorder.onstop = () => {
      const blob = new Blob(state.recordedChunks, { type: 'video/webm' });
      const url = URL.createObjectURL(blob);
      const clip = {
        id: newId(),
        type: 'video',
        name: `Gravação de tela ${new Date().toLocaleTimeString('pt-BR')}`,
        url,
        duration: state.recordSeconds,
        hasAudio: withAudio,
      };
      state.clips.push(clip);
      renderGallery();
      addToTimeline(clip.id);
      toast('Gravação adicionada aos clipes');
      stream.getTracks().forEach(t => t.stop());
    };
    // se o usuário parar de compartilhar pela UI do navegador
    stream.getVideoTracks()[0].addEventListener('ended', () => stopRecording());

    state.mediaRecorder.start();
    state.recordSeconds = 0;
    recordStatus.hidden = false;
    btnRecord.textContent = '■ Parar gravação';
    state.recordTimerId = setInterval(() => {
      state.recordSeconds++;
      recordTimer.textContent = fmtTime(state.recordSeconds);
    }, 1000);
  } catch (err) {
    toast('Não foi possível iniciar a gravação (permissão negada?)');
  }
});

function stopRecording() {
  if (state.mediaRecorder && state.mediaRecorder.state === 'recording') {
    state.mediaRecorder.stop();
  }
  clearInterval(state.recordTimerId);
  recordStatus.hidden = true;
  btnRecord.textContent = '● Iniciar gravação';
}

/* =========================================================
   04 — EFEITOS SONOROS
   ========================================================= */
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playSynthSfx(kind) {
  const now = audioCtx.currentTime;
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.connect(gain).connect(audioCtx.destination);
  const presets = {
    pop:   { type: 'sine', f1: 600, f2: 200, dur: 0.12 },
    whoosh:{ type: 'sawtooth', f1: 100, f2: 900, dur: 0.35 },
    click: { type: 'square', f1: 1000, f2: 1000, dur: 0.04 },
    alert: { type: 'triangle', f1: 880, f2: 880, dur: 0.28 },
    boom:  { type: 'sine', f1: 150, f2: 40, dur: 0.5 },
    ding:  { type: 'sine', f1: 1200, f2: 1600, dur: 0.3 },
  };
  const p = presets[kind] || presets.pop;
  osc.type = p.type;
  osc.frequency.setValueAtTime(p.f1, now);
  osc.frequency.exponentialRampToValueAtTime(Math.max(p.f2, 1), now + p.dur);
  gain.gain.setValueAtTime(0.25, now);
  gain.gain.exponentialRampToValueAtTime(0.001, now + p.dur);
  osc.start(now);
  osc.stop(now + p.dur + 0.02);
}

document.querySelectorAll('.sfx-chip').forEach(chip => {
  chip.addEventListener('click', () => {
    playSynthSfx(chip.dataset.sfx);
    const a = { id: newId(), name: `SFX: ${chip.textContent}`, url: null, duration: 0.6 };
    state.audioClips.push(a);
    renderTimeline();
    toast(`Efeito "${chip.textContent}" adicionado à trilha de áudio`);
  });
});

$('#btnAddSfxUrl').addEventListener('click', () => {
  const url = $('#sfxUrl').value.trim();
  if (!url) { toast('Cole um link de áudio válido'); return; }
  const a = { id: newId(), name: 'Som externo', url, duration: 2 };
  state.audioClips.push(a);
  renderTimeline();
  $('#sfxUrl').value = '';
  toast('Som externo adicionado à trilha de áudio');
});

/* =========================================================
   05 — TEXTO NA TELA
   ========================================================= */
const overlayText = $('#overlayText');
const textList = $('#textList');

$('#btnAddText').addEventListener('click', () => {
  const text = $('#textContent').value.trim();
  if (!text) { toast('Digite algum texto'); return; }
  const overlay = {
    id: newId(),
    text,
    start: +$('#textStart').value,
    duration: +$('#textDuration').value,
    color: $('#textColor').value,
    pos: $('#textPos').value,
  };
  state.textOverlays.push(overlay);
  renderTextList();
  $('#textContent').value = '';
  toast('Texto adicionado');
});

function renderTextList() {
  textList.innerHTML = '';
  state.textOverlays.forEach(o => {
    const li = document.createElement('li');
    li.innerHTML = `<span>"${o.text}" — ${fmtTime(o.start)} (${o.duration}s)</span><button class="remove">✕</button>`;
    li.querySelector('.remove').addEventListener('click', () => {
      state.textOverlays = state.textOverlays.filter(t => t.id !== o.id);
      renderTextList();
    });
    textList.appendChild(li);
  });
}

function updateTextOverlay(currentTime) {
  const active = state.textOverlays.find(o => currentTime >= o.start && currentTime <= o.start + o.duration);
  if (active) {
    overlayText.hidden = false;
    overlayText.textContent = active.text;
    overlayText.style.color = active.color;
    overlayText.className = 'overlay-text pos-' + active.pos;
  } else {
    overlayText.hidden = true;
  }
}

/* =========================================================
   06 — JUNTAR (lista espelha a linha do tempo, permite reordenar/remover)
   ========================================================= */
const joinList = $('#joinList');
function renderJoinList() {
  joinList.innerHTML = '';
  state.timeline.forEach((id, i) => {
    const clip = getClip(id);
    if (!clip) return;
    const li = document.createElement('li');
    li.draggable = true;
    li.dataset.id = id;
    li.innerHTML = `<span>${i + 1}. ${clip.name}</span><button class="remove">✕</button>`;
    li.querySelector('.remove').addEventListener('click', () => {
      state.timeline = state.timeline.filter(t => t !== id);
      renderTimeline();
    });
    li.addEventListener('dragstart', (e) => e.dataTransfer.setData('text/join-id', id));
    li.addEventListener('dragover', (e) => e.preventDefault());
    li.addEventListener('drop', (e) => {
      e.preventDefault();
      const draggedId = e.dataTransfer.getData('text/join-id');
      const from = state.timeline.indexOf(draggedId);
      const to = state.timeline.indexOf(id);
      if (from === -1 || to === -1) return;
      state.timeline.splice(from, 1);
      state.timeline.splice(to, 0, draggedId);
      renderTimeline();
    });
    joinList.appendChild(li);
  });
}

/* =========================================================
   07 — ÁUDIO (independente do vídeo)
   ========================================================= */
const audioStart = $('#audioStart'), audioEnd = $('#audioEnd');
function updateAudioLabels() {
  $('#audioStartVal').textContent = fmtTime(+audioStart.value);
  $('#audioEndVal').textContent = fmtTime(+audioEnd.value);
}
audioStart.addEventListener('input', updateAudioLabels);
audioEnd.addEventListener('input', updateAudioLabels);

$('#muteOriginal').addEventListener('change', (e) => {
  const clip = getClip(state.selectedClipId);
  if (!clip) return;
  clip.hasAudio = !e.target.checked;
  previewVideo.muted = e.target.checked;
  toast(clip.hasAudio ? 'Áudio original ativado' : 'Áudio original silenciado');
});

$('#btnCutAudio').addEventListener('click', () => {
  const clip = getClip(state.selectedClipId);
  if (!clip) { toast('Selecione um clipe primeiro'); return; }
  const start = +audioStart.value, end = +audioEnd.value;
  if (end <= start) { toast('O fim precisa ser depois do início'); return; }
  const a = {
    id: newId(),
    name: `Áudio de ${clip.name} (${fmtTime(start)}–${fmtTime(end)})`,
    url: clip.url,
    duration: end - start,
    sourceClipId: clip.id,
  };
  state.audioClips.push(a);
  renderTimeline();
  toast('Trecho de áudio extraído para a trilha de áudio');
});

/* =========================================================
   TOPBAR: novo projeto / desfazer / exportar
   ========================================================= */
$('#btnNew').addEventListener('click', () => {
  if (!confirm('Começar um novo projeto? Os clipes atuais desta sessão serão perdidos.')) return;
  state.clips = []; state.audioClips = []; state.timeline = []; state.textOverlays = [];
  state.selectedClipId = null;
  renderGallery(); renderTimeline(); renderTextList();
  previewVideo.removeAttribute('src'); previewImage.removeAttribute('src');
  previewEmpty.hidden = false;
  toast('Novo projeto iniciado');
});

$('#btnUndo').addEventListener('click', () => {
  if (state.timeline.length === 0) { toast('Nada para desfazer'); return; }
  const removed = state.timeline.pop();
  renderTimeline();
  toast('Último item da linha do tempo removido');
});

$('#btnExport').addEventListener('click', () => {
  const clip = getClip(state.selectedClipId);
  if (!clip) { toast('Selecione um clipe para exportar'); return; }
  const a = document.createElement('a');
  a.href = clip.url;
  a.download = clip.name.replace(/[^a-z0-9.\-_ ]/gi, '_') + (clip.type === 'video' ? '.webm' : '.jpg');
  a.click();
  toast('Exportando o clipe selecionado — junte vídeos com ffmpeg.wasm para gerar um arquivo único (veja o README)');
});

/* estado inicial */
renderTimeline();

</script>
</body>
</html>
