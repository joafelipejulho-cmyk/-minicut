- \{
  box\-sizing: border\-box;
  margin: 0;
  padding: 0;
  \}

body \{
font\-family: Arial, Helvetica, sans\-serif;
background: \#080808;
color: white;
height: 100vh;
overflow: hidden;
\}

button \{
font\-family: inherit;
border: none;
cursor: pointer;
\}

\.topbar \{
height: 64px;
background: \#111111;
border\-bottom: 1px solid \#292929;
display: flex;
align\-items: center;
padding: 0 18px;
position: relative;
z\-index: 10;
\}

\.logo \{
display: flex;
align\-items: center;
gap: 10px;
font\-size: 21px;
font\-weight: bold;
letter\-spacing: 1px;
\}

\.logo \> span:last\-child span \{
color: \#ff2020;
\}

\.logo\-icon \{
width: 34px;
height: 34px;
border\-radius: 9px;
background: \#e50914;
display: flex;
align\-items: center;
justify\-content: center;
font\-size: 18px;
\}

\.project\-name \{
position: absolute;
left: 50%;
transform: translateX&#40;\-50%&#41;;
color: \#bdbdbd;
font\-size: 14px;
\}

\.export\-btn \{
margin\-left: auto;
background: \#e50914;
color: white;
padding: 10px 19px;
border\-radius: 7px;
font\-weight: bold;
transition: 0\.2s;
\}

\.export\-btn:hover \{
background: \#ff2525;
\}

\.editor \{
height: calc&#40;100vh \- 64px&#41;;
display: flex;
\}

\.sidebar \{
width: 82px;
background: \#0d0d0d;
border\-right: 1px solid \#292929;
display: flex;
flex\-direction: column;
align\-items: center;
padding: 12px 7px;
gap: 8px;
\}

\.tool \{
width: 68px;
min\-height: 62px;
background: transparent;
color: \#999;
border\-radius: 9px;
display: flex;
flex\-direction: column;
align\-items: center;
justify\-content: center;
gap: 5px;
transition: 0\.2s;
\}

\.tool span \{
font\-size: 22px;
\}

\.tool small \{
font\-size: 10px;
\}

\.tool:hover \{
background: \#1d1d1d;
color: white;
\}

\.tool\.active \{
background: \#3b0909;
color: white;
border\-left: 3px solid \#e50914;
\}

\.workspace \{
flex: 1;
min\-width: 0;
display: flex;
flex\-direction: column;
background: \#101010;
\}

\.preview\-area \{
flex: 1;
min\-height: 0;
display: flex;
flex\-direction: column;
align\-items: center;
justify\-content: center;
padding: 20px;
\}

\.preview \{
width: min&#40;760px, 90%&#41;;
height: min&#40;430px, 60vh&#41;;
background: \#050505;
border: 1px solid \#292929;
border\-radius: 8px;
display: flex;
align\-items: center;
justify\-content: center;
box\-shadow: 0 15px 50px rgba&#40;0, 0, 0, 0\.4&#41;;
\}

\.preview\-placeholder \{
text\-align: center;
color: \#656565;
\}

\.play\-icon \{
width: 58px;
height: 58px;
margin: 0 auto 12px;
border\-radius: 50%;
background: \#1d1d1d;
display: flex;
align\-items: center;
justify\-content: center;
color: \#e50914;
font\-size: 22px;
\}

\.preview\-placeholder p \{
font\-size: 13px;
\}

\.preview\-controls \{
width: min&#40;760px, 90%&#41;;
height: 48px;
display: flex;
align\-items: center;
gap: 15px;
color: \#aaa;
\}

\.preview\-controls button \{
background: transparent;
color: \#aaa;
font\-size: 17px;
\}

